# Local development only; replace before any deployment.
POSTGRES_USER=techcards
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=techcards
# Published loopback port; PostgreSQL inside Compose stays on 5432.
POSTGRES_HOST_PORT=5435
DATABASE_URL=postgresql+psycopg://techcards:local-development-only@localhost:5435/techcards
GENERATOR_PROVIDER=mock
